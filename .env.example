# Database
DATABASE_URL=postgresql://user:password@localhost:5432/visitecrm

# Email (Resend)
# On Replit, connect Resend through Integrations; the CRM then uses the secure
# connector and no API key needs to be copied into the project. For standalone
# deployments without a Replit connection, set RESEND_API_KEY instead.
RESEND_API_KEY=re_...
# Required in production: this sender domain must be verified in the connected
# Resend account. Development uses Resend's onboarding@resend.dev test sender
# when this is unset.
RESEND_FROM_EMAIL=VisiteCRM <reservas@resend.visitecrm.com>

# Redis (BullMQ async job queue)
# Required only for async email queuing, retry, and scheduled reminders.
# When absent, emails are sent synchronously (no queue, no retries).
# Leave this unset unless you intentionally connect a Redis service.
# Recommended: Upstash Redis (see task #289 for provisioning guide).
# Format: redis://default:<password>@<host>:<port>
REDIS_URL=redis://default:password@localhost:6379

# Reminder scheduling (optional — defaults below are suitable for Brazil)
# REMINDER_CRON controls when daily reminder jobs run (cron syntax).
# REMINDER_TZ sets the timezone for the cron schedule.
# Default: 08:00 daily in America/Sao_Paulo (BRT/BRST, UTC-3/-2).
REMINDER_CRON=0 8 * * *
REMINDER_TZ=America/Sao_Paulo

# Auth (Clerk)
CLERK_SECRET_KEY=sk_...
VITE_CLERK_PUBLISHABLE_KEY=pk_...

# UploadThing
# Store this as a Replit Secret (never commit it to a local .env file).
UPLOADTHING_TOKEN=...

# Google Calendar (optional)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
