{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./financial-category-integrity": {
      "types": "./scripts/verify-financial-category-integrity.d.mts",
      "import": "./scripts/verify-financial-category-integrity.mjs"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "node scripts/prepare-empty-migrations-cli.mjs",
    "verify-clean-migration": "node scripts/verify-clean-migration.mjs",
    "test:migration-concurrency": "node scripts/migration-concurrency.integration.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "check": "drizzle-kit check --config ./drizzle.config.ts",
    "validate-coverage": "node scripts/validate-coverage.mjs",
    "validate-columns": "node scripts/validate-columns.mjs",
    "validate-tables": "node scripts/validate-tables.mjs",
    "verify-db": "node scripts/verify-db-columns.mjs",
    "schema-drift": "node scripts/schema-drift.mjs",
    "benchmark:financial-integrity": "node scripts/benchmark-financial-category-integrity.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@workspace/permissions": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9"
  }
}
